/* scrollspy: resalta el chip de la sección visible */
const chips = [...document.querySelectorAll(".chip")];
const targets = chipData.map(c=>document.getElementById(c.id)).filter(Boolean);
const setActive = id => chips.forEach(ch=>ch.classList.toggle("active", ch.dataset.id===id));
const spy = new IntersectionObserver((entries)=>{
  entries.forEach(e=>{
    if(e.isIntersecting){
      setActive(e.target.id);
      const chip = chips.find(c=>c.dataset.id===e.target.id);
      if(chip) chip.scrollIntoView({block:"nearest",inline:"center",behavior:"smooth"});
    }
  });
},{rootMargin:"-45% 0px -50% 0px",threshold:0});
targets.forEach(t=>spy.observe(t));
