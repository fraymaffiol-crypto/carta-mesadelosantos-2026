const esc = s => (s||"").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));

function itemHTML(it){
  const tag = it.tag ? ` <span class="tag">${esc(it.tag)}</span>` : "";
  const desc = it.d ? `<p class="item-desc">${esc(it.d)}</p>` : "";
  const price = it.p ? `<span class="dots"></span><span class="price">${esc(it.p)}</span>` : "";
  const vars = it.vars ? `<div class="variants">${it.vars.map(v=>`<span class="variant">${esc(v.l)} <b>${esc(v.p)}</b></span>`).join("")}</div>` : "";
  return `<article class="item">
    <div class="item-head"><h3 class="item-name">${esc(it.n)}${tag}</h3>${price}</div>
    ${desc}${vars}
  </article>`;
}

function sectionHTML(sec){
  let inner = "";
  if(sec.compact){
    inner = `<div class="compact">${sec.items.map(it=>
      `<div class="crow"><span class="n">${esc(it.n)}</span><span class="d"></span><span class="p">${esc(it.p)}</span></div>`
    ).join("")}</div>`;
  } else if(sec.groups){
    inner = `<div class="bev-groups">${sec.groups.map(g=>`
      <div class="bev-group">
        <h3>${esc(g.label)}</h3>
        ${g.rows.map(r=>{
          const sub=r.s?`<small>${esc(r.s)}</small>`:"";
          return `<div class="bev-row"><span class="bn">${esc(r.n)}${sub}</span><span class="bd"></span><span class="bp">${esc(r.p)}</span></div>`;
        }).join("")}
      </div>`).join("")}</div>`;
  } else {
    const cols = sec.three ? "grid three" : "grid";
    inner = `<div class="${cols}">${sec.items.map(itemHTML).join("")}</div>`;
  }
  const quote = sec.quote ? `<p class="quote">${sec.quote}</p>` : "";
  const mini = (sec.items && sec.items.length<=2 && !sec.compact) ? " mini":"";
  return `<section class="section" id="${sec.id}">
    <div class="divider"><span class="cenefa"></span></div>
    <div class="sec-head${mini}"><h2>${esc(sec.title)}</h2><span class="en">${esc(sec.en)}</span></div>
    ${inner}${quote}
  </section>`;
}

